{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntroductionAndRelatedWorkWritingPlan",
  "type": "object",
  "required": [
    "case_id",
    "language",
    "citation_style",
    "background_claims",
    "related_work_groups",
    "gap_derivations",
    "contributions",
    "prose_sections",
    "uncertainties",
    "change_records"
  ],
  "properties": {
    "case_id": { "type": "string" },
    "language": { "type": "string", "enum": ["zh", "en", "bilingual"] },
    "citation_style": { "type": "string", "enum": ["latex-cite", "pandoc-key", "numeric", "author-year"] },
    "target_format": { "type": "string", "enum": ["markdown", "latex", "both"] },
    "background_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "evidence_type", "source_ids"],
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string" },
          "evidence_type": { "type": "string", "enum": ["cited_fact", "author_evidence", "author_judgment", "needs_evidence"] },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "locator": { "type": "string" }
        }
      }
    },
    "related_work_groups": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["group_id", "group_title", "grouping_axis", "comparison_dimensions", "works", "group_synthesis"],
        "properties": {
          "group_id": { "type": "string" },
          "group_title": { "type": "string" },
          "grouping_axis": { "type": "string" },
          "comparison_dimensions": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "works": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["ref_id", "core_method", "key_finding", "applicable_condition", "limitation", "source_locator"],
              "properties": {
                "ref_id": { "type": "string" },
                "core_method": { "type": "string" },
                "key_finding": { "type": "string" },
                "applicable_condition": { "type": "string" },
                "limitation": { "type": "string" },
                "source_locator": { "type": "string" }
              }
            }
          },
          "group_synthesis": { "type": "string" }
        }
      }
    },
    "gap_derivations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gap_id", "derived_from_refs", "limitation_or_conflict", "gap_statement", "how_this_work_addresses", "evidence_status"],
        "properties": {
          "gap_id": { "type": "string" },
          "derived_from_refs": { "type": "array", "items": { "type": "string" } },
          "limitation_or_conflict": { "type": "string" },
          "gap_statement": { "type": "string" },
          "how_this_work_addresses": { "type": "string" },
          "evidence_status": { "type": "string", "enum": ["verified", "partial_material", "author_judgment"] }
        }
      }
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contrib_id", "statement", "supporting_evidence", "scope_boundary", "verification_status"],
        "properties": {
          "contrib_id": { "type": "string" },
          "statement": { "type": "string" },
          "supporting_evidence": { "type": "array", "items": { "type": "string" } },
          "numeric_claims": { "type": "array", "items": { "type": "string" } },
          "scope_boundary": { "type": "string" },
          "verification_status": { "type": "string", "enum": ["verified", "needs_author_confirmation"] }
        }
      }
    },
    "prose_sections": {
      "type": "object",
      "required": ["background", "related_work", "research_gap", "contributions"],
      "properties": {
        "background": { "type": "string" },
        "related_work": { "type": "string" },
        "research_gap": { "type": "string" },
        "contributions": { "type": "string" }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "category", "action_needed"],
        "properties": {
          "item": { "type": "string" },
          "category": { "type": "string" },
          "action_needed": { "type": "string" }
        }
      }
    },
    "change_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "change", "reason"],
        "properties": {
          "section": { "type": "string" },
          "change": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
