{
  "version": "1.0.0",
  "description": "Canonical parameter aliases and regex rules for extracting experimental facts from YAML, JSON, INI, TOML, Python, Shell, and log files.",
  "canonical_parameter_aliases": {
    "learning_rate": ["lr", "learning_rate", "base_lr", "init_lr", "step_size", "eta"],
    "batch_size": ["batch_size", "bs", "train_batch_size", "per_device_train_batch_size", "micro_batch_size"],
    "epochs": ["epochs", "num_epochs", "max_epochs", "n_epochs", "num_train_epochs"],
    "optimizer": ["optimizer", "optim", "opt"],
    "weight_decay": ["weight_decay", "wd", "l2_reg"],
    "dropout": ["dropout", "dropout_rate", "drop_rate"],
    "seed": ["seed", "random_seed", "manual_seed", "torch_seed", "np_seed", "seeds"],
    "repeat_count": ["num_runs", "n_runs", "repeats", "n_repeats", "num_seeds", "k_folds", "n_splits"],
    "temperature": ["temperature", "temp", "reaction_temp", "T_K", "T_C"],
    "pressure": ["pressure", "press", "P_bar", "P_MPa"],
    "max_seq_len": ["max_len", "max_seq_len", "context_length", "block_size"],
    "hidden_dim": ["hidden_dim", "hidden_size", "d_model", "embed_dim"],
    "num_layers": ["num_layers", "n_layers", "depth"],
    "warmup_steps": ["warmup_steps", "warmup_ratio", "warmup_epochs"],
    "split_ratio": ["split_ratio", "train_val_test", "test_size", "val_size"]
  },
  "environment_patterns": {
    "hardware": [
      "(?:NVIDIA|GeForce|Tesla|RTX|A100|H100|V100|T4|L40S?|RTX\\s*\\d{4}|AMD\\s+EPYC|Intel\\s+Xeon|Apple\\s+M\\d)[^\\n,;]{0,60}",
      "(?:gpu|device)\\s*[:=]\\s*['\"]?([A-Za-z0-9_\\s:+/-]{2,40})"
    ],
    "software": [
      "(?:python|pytorch|torch|tensorflow|cuda|cudnn|scikit-learn|sklearn|numpy|scipy|transformers|rdkit|gromacs|lammps|vasp|gaussian)\\s*(?:==|>=|<=|:|=|v)?\\s*\\d+(?:\\.\\d+){0,3}[A-Za-z0-9+._-]*"
    ],
    "cli_command": [
      "(?:^|\\n)\\s*(?:python3?|torchrun|accelerate|deepspeed|bash|sh|mpirun|gmx|lmp)\\s+[^\\n]{5,240}"
    ],
    "dataset_version": [
      "(?:dataset|corpus|benchmark)\\s*(?:name|version)?\\s*[:=]\\s*['\"]?([A-Za-z0-9_./\\s-]{2,60})",
      "\\bv\\d+(?:\\.\\d+){1,2}\\b"
    ]
  }
}
