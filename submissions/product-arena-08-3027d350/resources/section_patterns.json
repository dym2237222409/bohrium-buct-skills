{
  "version": "1.0.0",
  "description": "Bilingual (EN/ZH) academic section, caption, equation, footnote, and bibliography structural grammar patterns.",
  "canonical_unnumbered_headings": [
    "abstract",
    "graphical abstract",
    "summary",
    "keywords",
    "key words",
    "index terms",
    "introduction",
    "background",
    "related work",
    "literature review",
    "preliminaries",
    "materials and methods",
    "methods",
    "methodology",
    "experimental",
    "experimental section",
    "experimental setup",
    "implementation details",
    "results",
    "results and discussion",
    "discussion",
    "analysis",
    "ablation study",
    "limitations",
    "conclusion",
    "conclusions",
    "concluding remarks",
    "future work",
    "acknowledgments",
    "acknowledgements",
    "funding",
    "author contributions",
    "competing interests",
    "conflict of interest",
    "conflicts of interest",
    "data availability",
    "code availability",
    "supplementary information",
    "supporting information",
    "appendix",
    "appendices",
    "references",
    "bibliography",
    "摘要",
    "关键词",
    "引言",
    "前言",
    "研究背景",
    "相关工作",
    "实验部分",
    "材料与方法",
    "研究方法",
    "实验与方法",
    "结果与讨论",
    "实验结果",
    "讨论",
    "结论",
    "总结与展望",
    "局限性",
    "致谢",
    "利益冲突",
    "数据可用性",
    "附录",
    "参考文献"
  ],
  "numbered_heading_regexes": [
    "^(?P<num>\\d+(?:\\.\\d+){0,3})\\.?\\s+(?P<title>[A-Z\\u4e00-\\u9fff][^\\n]{1,120})$",
    "^(?P<num>[IVX]{1,5})\\.\\s+(?P<title>[A-Z\\u4e00-\\u9fff][^\\n]{1,120})$",
    "^(?P<num>Appendix\\s+[A-Z0-9]+|附录\\s*[A-Z0-9一二三四五]*)[:.\\s]+(?P<title>[^\\n]{1,120})$",
    "^(?P<num>第[一二三四五六七八九十0-9]+[章节部分])\\s*(?P<title>[\\u4e00-\\u9fffA-Za-z][^\\n]{1,100})$"
  ],
  "caption_regexes": {
    "figure": "^(?:Fig\\.?|Figure|Scheme|Chart|图)\\s*(?P<id>[S]?\\d+[A-Za-z]?(?:[-–.]\\d+)?)\\s*[:.\\-|—]?\\s*(?P<caption>.*)$",
    "table": "^(?:Tab\\.?|Table|表|续表)\\s*(?P<id>[S]?\\d+[A-Za-z]?(?:[-–.]\\d+)?)\\s*(?P<cont>\\(continued\\)|continued|续)?\\s*[:.\\-|—]?\\s*(?P<caption>.*)$"
  },
  "equation_number_regex": "(?:\\(|\\[)(?:Eq\\.?\\s*)?(?P<eq_num>[A-Z]?\\d+(?:\\.\\d+)?[a-z]?)(?:\\)|\\])\\s*$",
  "reference_section_titles": [
    "references",
    "bibliography",
    "literature cited",
    "works cited",
    "参考文献",
    "引用文献"
  ],
  "footnote_line_regex": "^(?:[*†‡§¶]|\\d{1,2}[.)]?|\\[\\d{1,2}\\])\\s+\\S+"
}
